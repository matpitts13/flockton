// The Flockton website in site/. Deploy with: npx wrangler@4.160.0 deploy
// Static files only, on Cloudflare Workers' free plan.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "flockton",
  "compatibility_date": "2026-11-19",
  "assets": { "directory": "site" },
  "routes": [{ "pattern": "flock-ton.ravenburst.com", "custom_domain": true }]
}
